# Stikbook Backend — Environment Variables
# Copy this file to `.env` and fill in real values.

# Gmail account used to send application emails
EMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your-app-password

# Email address that receives new job applications
NOTIFY_EMAIL=hr@stikbook.com

# Server port (optional)
PORT=3001

# Comma-separated list of allowed origins for CORS
# Example: https://stikbook.com,https://www.stikbook.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
