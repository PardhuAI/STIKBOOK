# Stikbook Frontend — Environment Variables
# Copy this file to `.env.local` and fill in real values.

# --- Email service (used by the /api/apply route) ---
# Gmail account used to send job-application emails
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-app-password

# Email address that receives new job applications
NOTIFY_EMAIL=hr@stikbook.com

# --- Contact form ---
# Google Apps Script Web App URL that receives contact submissions
NEXT_PUBLIC_CONTACT_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
